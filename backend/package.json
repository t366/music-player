{
  "name": "cloud-music",
  "version": "2.0.0",
  "description": "云音乐Web播放器",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "setup": "mkdir -p music covers lyrics data avatars logs",
    "clean": "rm -rf node_modules package-lock.json",
    "reset": "rm -rf data/*.json logs/*",
    "backup": "tar -czf backup_$(date +%Y%m%d_%H%M%S).tar.gz music covers lyrics data",
    "test": "jest --testTimeout=10000"
  },
  "keywords": [
    "music",
    "player",
    "streaming",
    "web"
  ],
  "author": "云音乐团队",
  "license": "MIT",
  "dependencies": {
    "acoustid": "^1.2.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "https-proxy-agent": "^7.0.5",
    "iconv-lite": "^0.7.1",
    "multer": "^2.0.2",
    "music-metadata": "^11.10.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
